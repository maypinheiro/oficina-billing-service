{
  "name": "oficina-billing-service",
  "version": "0.1.0",
  "private": true,
  "description": "Microsserviço de orçamento e pagamento da Oficina",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "data:migrate": "tsx scripts/migrate-legacy-data.ts",
    "data:reconcile": "tsx scripts/reconcile-legacy-data.ts",
    "test": "node --import tsx --test tests/**/*.spec.ts",
    "test:coverage": "c8 --check-coverage --lines 80 --functions 80 --branches 80 --statements 80 node --import tsx --test tests/**/*.spec.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/node": "^22.10.0",
    "c8": "^10.1.3",
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
